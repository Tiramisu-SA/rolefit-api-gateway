# Settings for scripts/measure-performance.mjs. Copy to scripts/perf.env and fill in.
# Never commit perf.env. SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY are read from
# deploy/.env when they are not set here.

GATEWAY_URL=http://localhost:8080

# A test job seeker account that already has a profile. Generating a draft
# replaces that account's draft for the job, so do not use a real user.
PERF_SEEKER_EMAIL=
PERF_SEEKER_PASSWORD=

# Optional: the job to use (default: the first open job).
PERF_JOB_ID=

# Optional: a .pdf or .docx resume, to time resume parsing (FR-02).
PERF_RESUME_FILE=
