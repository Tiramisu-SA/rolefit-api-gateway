# Secrets for docker-compose.yml. Copy to .env and fill in. Never commit .env.
# Service addresses are not configured here: services find each other by name
# through Docker's DNS (see docker-compose.yml).

# Supabase Auth project (used by the gateway, Candidate Profile and Resume Preparation)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Candidate Profile database (Supabase PostgreSQL)
CANDIDATE_PROFILE_DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres

# Job Posting database (MongoDB Atlas)
JOB_POSTING_MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/rolefit_job_posting
